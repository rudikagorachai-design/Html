/* Professional Design Variables & Theme Settings */
:root {
    --bg-gradient: linear-gradient(135deg, #e0ebf8 0%, #e6e6fa 50%, #f4f7fb 100%);
    --text-main: #1e293b;
    --text-muted: #64748b;
    --header-bg: rgba(255, 255, 255, 0.85);
    --card-bg: #ffffff;
    --accent-color: #0066cc;
    --shadow-color: rgba(0, 102, 204, 0.08);
}

/* Dark Mode Theme Adjustments */
[data-theme="dark"] {
    --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --header-bg: rgba(15, 23, 42, 0.85);
    --card-bg: #1e293b;
    --accent-color: #38bdf8;
    --shadow-color: rgba(0, 0, 0, 0.4);
}

/* Global Setup Reset */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--bg-gradient);
    color: var(--text-main);
    min-height: 100vh;
    transition: background 0.4s ease, color 0.3s ease;
    line-height: 1.5;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px;
}

/* Polished Header Navbar (Sticky & Glassmorphism effect) */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 40px;
    background-color: var(--header-bg);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}

.logo {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-main);
    font-weight: 500;
    transition: color 0.2s;
}

.nav-links a:hover {
    color: var(--accent-color);
}

#theme-toggle {
    background-color: var(--accent-color);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    transition: transform 0.2s;
}

#theme-toggle:hover {
    transform: scale(1.05);
}

/* Hero Profile Section layout */
.hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: 20px;
    margin-bottom: 50px;
}

.hero-content {
    flex: 1;
}

.hero-content h1 {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 20px;
    letter-spacing: -1px;
}

.subtitle {
    font-size: 1.25rem;
    color: var(--text-main);
    margin-bottom: 15px;
}

.description {
    color: var(--text-muted);
    font-size: 1.05rem;
}

/* Beautiful Circular Photo Layout */
.hero-image-container {
    flex-shrink: 0;
}

.profile-img {
    width: 240px;
    height: 240px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid white;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s;
}

.profile-img:hover {
    transform: scale(1.03);
}

/* Grid Cards (Side-by-Side Flex/Grid Setup) */
.two-column-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-bottom: 40px;
}

.card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 10px 30px var(--shadow-color);
    border: 1px solid rgba(255,255,255,0.2);
}

.grid-card h2 {
    font-size: 1.4rem;
    margin-bottom: 20px;
    font-weight: 700;
}

/* Hobby styling lists */
.hobby-list {
    list-style: none;
}

.hobby-list li {
    padding: 12px 0;
    font-size: 1.1rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
}

.hobby-list .icon {
    margin-right: 12px;
    font-size: 1.3rem;
}

/* Big Vibrant Countdown Timer Display */
.highlight-card {
    text-align: center;
}

#countdown-timer {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0052cc;
    margin: 15px 0;
    font-variant-numeric: tabular-nums;
}

[data-theme="dark"] #countdown-timer {
    color: #38bdf8;
}

.card-caption {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* Form Design Structure */
.form-group {
    display: flex;
    gap: 15px;
    margin-top: 25px;
    margin-bottom: 15px;
}

input, textarea {
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: var(--card-bg);
    color: var(--text-main);
    font-size: 1rem;
}

.btn-submit {
    background-color: #0052cc;
    color: white;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.2s;
}

.btn-submit:hover {
    background-color: #0041a3;
}

#messages-container {
    margin-top: 20px;
    max-height: 200px;
    overflow-y: auto;
}

.user-msg {
    background: rgba(0,0,0,0.02);
    padding: 10px 15px;
    border-radius: 8px;
    margin-bottom: 8px;
    font-size: 0.95rem;
}

/* Sticky Bottom Footer */
footer {
    text-align: center;
    padding: 30px;
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 40px;
    background: var(--header-bg);
}

/* Responsive Breakpoint for Mobile Screens */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 15px;
    }
    .hero-section {
        flex-direction: column-reverse;
        text-align: center;
    }
    .two-column-grid {
        grid-template-columns: 1fr;
    }
    .form-group {
        flex-direction: column;
    }
}
